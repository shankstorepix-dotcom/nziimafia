# ====================================================================
# NZI MAFIA — VARIÁVEIS DE AMBIENTE RECOMENDADAS (PRODUÇÃO & VERCEL)
# ====================================================================

# 1. Chave Secreta para JWT e Criptografia AES-256 (Mínimo 32 caracteres randômicos)
# Gere usando: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=coloque_aqui_uma_chave_secreta_com_pelo_menos_32_caracteres_aleatorios

# 2. Token Seguro do Bot Guard NZI no Discord (Isolado no servidor)
DISCORD_BOT_TOKEN=seu_novo_token_do_bot_discord_aqui
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/seu_webhook_aqui

# 3. Webhook de Recrutamento (Notificações de candidaturas para a equipe)
RECRUITMENT_DISCORD_WEBHOOK=https://discord.com/api/webhooks/seu_webhook_recrutamento_aqui

# 4. Chave Mestra para Setup Inicial de Administrador (Mínimo 16 caracteres)
ADMIN_SETUP_SECRET=chave_mestra_setup_inicial_admin_super_segura_16caracteres

# 5. Senha Inicial do Owner em Setup Limpo (Opcional)
ADMIN_INITIAL_PASSWORD=Senha#Mestra2026!OwnerSeguro

# 6. Supabase (Obrigatório para persistência serverless permanente na Vercel)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_secreta

# 7. Segurança de Rede e CDN (Cloudflare & Vercel)
TRUST_PROXY=1
ALLOWED_ORIGINS=https://nzimafia.vercel.app,https://nzimafia.com

# 8. Rastreamento e Privacidade (LGPD)
TRACKING_RETENTION_DAYS=90
TRACKING_HASH_SECRET=chave_secreta_para_pseudonimizacao_lgpd
